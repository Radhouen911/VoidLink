@startuml
title Activity Diagram - User Flow (Two-Layer Auth)

start
:Open App;

if (Has account?) then (no)
  :Create account (username/password);
  :Setup crypto keys;
  :Choose key storage mode;
else (yes)
  :Login to account;
  :Load crypto keys;
  :Enter key passphrase;
endif

:Crypto authentication (challenge-response);
:Add contact;

if (Contact verified?) then (yes)
  :Secure chat;
else (no)
  :Chat (unverified warning);
endif

:Send / receive messages;

if (Manage keys?) then (yes)
  :Enable/disable cloud backup;
  :Update key storage;
endif

:Logout;

stop
@enduml
