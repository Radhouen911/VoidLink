@startuml
title Account Creation & Key Management Selection

actor User
participant Browser
participant "Crypto Module" as Crypto
participant "Local Storage\n(IndexedDB)" as LS
participant Server
database Database

User -> Browser: Create account + passphrase
Browser -> Crypto: generateKeyPair()
Crypto -> Crypto: encryptPrivateKey(passphrase)

Browser -> User: Choose key mode

alt Local-only key mode (Recommended)
  Crypto -> LS: store(encryptedPrivateKey)
else Cloud-backed key mode (Optional)
  Crypto -> LS: store(encryptedPrivateKey)
  Browser -> Server: uploadEncryptedKey(encryptedPrivateKey)
  Server -> Database: storeEncryptedKey()
end

Browser -> Server: register(username, publicKey)
Server -> Database: store(username, publicKey)

alt Registration successful
  Server -> Browser: success
else Username taken
  Server -> Browser: error
end

note right of Crypto
Private key is never stored
or transmitted in plaintext
end note

@enduml
