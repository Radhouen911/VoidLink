@startuml
title Sequence Diagram - Account Creation & Backup

actor User
participant "Browser Client" as Client
participant "Crypto Module" as Crypto
participant "Local Storage" as LS
participant "Server" as Server
database Database

User -> Client : Create account\n(passphrase)
Client -> Crypto : generateKeyPair()
Crypto -> Crypto : encryptPrivateKey\nAES-GCM(passphrase)
Crypto -> LS : store(encryptedPrivateKey, publicKey)

LS -> Client : createBackupFile()
Client -> User : auto-download backup file

Client -> Server : register(username, publicKey)\n[REST/HTTPS]
Server -> Database : insert(username, publicKey)

alt Username available
  Server -> Client : success
  Client -> User : Account created
else Username taken
  Server -> Client : error
  Client -> User : Choose another username
end

note right
🔒 Private key never sent to server
end note

@enduml
